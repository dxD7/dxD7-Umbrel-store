# ===========================================================
#  DelugeVPN settings
#
#  Easiest: open the app and fill in the setup page.
#  Manual:  edit this file, save, then RESTART the app.
#
#  Format: NAME=value. Values are read literally ("$" is fine);
#  one pair of outer quotes is optional.
# ===========================================================

# ---- Basics ------------------------------------------------

# VPN provider: pia | airvpn | protonvpn | custom
VPN_PROV=pia

# VPN protocol: wireguard | openvpn
VPN_CLIENT=wireguard

# Your VPN account login.
# PIA: your PIA username (looks like p1234567) and password.
VPN_USER=CHANGE_ME
VPN_PASS=CHANGE_ME

# PIA + WireGuard only: server location (must support port forwarding).
# Leave commented out for binhex's default (Amsterdam). To switch later,
# uncomment, set a hostname, and restart.
# VPN_REMOTE_SERVER=ca-montreal.privacy.network

# ---- Network -----------------------------------------------

# PIA / ProtonVPN only: require a forwarded port.
STRICT_PORT_FORWARD=yes

# Your home network in CIDR form (e.g. 192.168.0.0/24, 10.0.0.0/24).
# Only matters for extra published ports; the web UI goes through
# Umbrel's proxy and does not depend on it.
LAN_NETWORK=192.168.1.0/24

# DNS servers (comma separated)
NAME_SERVERS=84.200.69.80,37.235.1.174,1.1.1.1

# Privoxy (HTTP proxy through the VPN). Off by default. If you turn it on you
# also need to publish port 8118 in docker-compose.yml.
ENABLE_PRIVOXY=no

# ---- Advanced (optional) ------------------------------------
# Any other binhex/arch-delugevpn variable can be added here too.
# Uncomment only what you need.

# Only if your device's kernel has no WireGuard support:
# USERSPACE_WIREGUARD=yes

# Extra ports allowed through the VPN firewall (comma separated):
# VPN_INPUT_PORTS=
# VPN_OUTPUT_PORTS=

# OpenVPN only: extra command-line options:
# VPN_OPTIONS=

# SOCKS proxy through the VPN on port 9118. Also needs the port published in
# docker-compose.yml, and please set your own login (binhex's examples use
# a well-known default):
# ENABLE_SOCKS=yes
# SOCKS_USER=
# SOCKS_PASS=

# Extra logging for troubleshooting:
# DEBUG=true
